y4aha0r9ft","n":91136.5,"t":1793994389689,"p":{"type":"quest.dialogue.open","questId":"wastelands-the-last-caravan","questName":"The Last Caravan","npcName":"Tomas Reeve","dialogue":{"lines":[{"speaker":"npc","text":"That's Kerr's cloth. I'd know the weave anywhere. And his ledger. Let me see the last page."},{"speaker":"npc","text":"He sold the whole load before he ever set out, paid in full by a Thak quartermaster. Delivery to the vanguard camp on the Dune Sea."},{"speaker":"npc","text":"So the Thak bought the route. The caravans stopped coming north because they were all going to the Thak, and Kerr was driving to them when the storm caught him."},{"speaker":"npc","text":"I'll send the ledger to Sergeant Hallam at the post. She should know who is feeding that camp."},{"speaker":"npc","text":"Take this. It's more than the stall has made all season."}],"responses":[]}}},{"s":"mw5ay4aha0r9ft","n":91304,"t":1793994404927,"p":{"type":"atlas.findings","npcs":[{"id":"spawn_73d49fd5-a11f-4a4d-b6dd-9a363338a99c","typeId":"dust-devil","name":"Dust Devil","faction":"hostile","action":"none","maxHitpoints":152,"level":35,"scale":0.9,"attackRange":1.6,"aggroRange":7,"hitpoints":152,"inCombat":false,"behaviorState":"wandering","position":{"x":1797.54,"y":109.25,"z":0},"target":{"x":1797,"y":106,"z":0}}],"objects":[]}},{"s":"mw5ay4aha0r9ft","n":91789,"t":1793994428672,"p":{"type":"atlas.findings","npcs":[{"id":"spawn_dbdbdb6f-a894-4c3b-b57d-28750bbb2e3d","typeId":"dust-devil","name":"Dust Devil","faction":"hostile","action":"none","maxHitpoints":152,"level":35,"scale":0.9,"attackRange":1.6,"aggroRange":7,"hitpoints":152,"inCombat":false,"behaviorState":"wandering","position":{"x":1823.93,"y":127,"z":0},"target":{"x":1819,"y":127,"z":0}}],"objects":[]}}]}